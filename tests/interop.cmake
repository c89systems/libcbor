file(MAKE_DIRECTORY "${WORK}")
foreach(fixture scalars nested ascii utf8 large-ascii large-utf8)
  set(native "${WORK}/native-${fixture}.cbor")
  set(reference "${WORK}/reference-${fixture}.cbor")
  execute_process(COMMAND "${NATIVE}" emit "${fixture}" OUTPUT_FILE "${native}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${REFERENCE}" verify "${fixture}" INPUT_FILE "${native}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${REFERENCE}" emit "${fixture}" OUTPUT_FILE "${reference}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${NATIVE}" verify "${fixture}" INPUT_FILE "${reference}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${native}" "${reference}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
