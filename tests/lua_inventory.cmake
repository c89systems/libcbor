cmake_minimum_required(VERSION 3.21)
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${BINARY}" --show-only=json-v1
  RESULT_VARIABLE status OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Cannot inspect Lua test inventory: ${error}")
endif()
string(JSON count LENGTH "${inventory}" tests)
math(EXPR last "${count} - 1")
set(found)
foreach(i RANGE 0 ${last})
  string(JSON name GET "${inventory}" tests ${i} name)
  if(name STREQUAL "lua-api" OR name MATCHES "^lua-lifetime-")
    string(JSON argc LENGTH "${inventory}" tests ${i} command)
    math(EXPR command_last "${argc} - 2")
    set(actual_module "")
    foreach(k RANGE 0 ${command_last})
      string(JSON argument GET "${inventory}" tests ${i} command ${k})
      if(argument STREQUAL RUNNER)
        math(EXPR module_argument "${k} + 1")
        string(JSON actual_module GET "${inventory}" tests ${i} command ${module_argument})
        break()
      endif()
    endforeach()
    if(NOT actual_module STREQUAL MODULE)
      message(FATAL_ERROR "${name} tests ${actual_module}, expected ${MODULE}")
    endif()
    string(JSON properties LENGTH "${inventory}" tests ${i} properties)
    math(EXPR property_last "${properties} - 1")
    set(environment)
    set(labels)
    foreach(j RANGE 0 ${property_last})
      string(JSON property GET "${inventory}" tests ${i} properties ${j} name)
      if(property STREQUAL "ENVIRONMENT")
        string(JSON environment GET "${inventory}" tests ${i} properties ${j} value)
      elseif(property STREQUAL "LABELS")
        string(JSON labels GET "${inventory}" tests ${i} properties ${j} value)
      endif()
    endforeach()
    if(NOT environment MATCHES "GLIBC_TUNABLES=glibc.pthread.stack_cache_size=0")
      message(FATAL_ERROR "${name} lost its worker-stack environment")
    endif()
    if(NOT labels MATCHES "\"lua\"")
      message(FATAL_ERROR "${name} was omitted from the Lua memory-check selection")
    endif()
    if(name MATCHES "^lua-lifetime-(.+)$")
      set(group "${CMAKE_MATCH_1}")
      if(NOT environment MATCHES "C89CBOR_LUA_LIFETIME_CASE=${group}\"")
        message(FATAL_ERROR "${name} lost its fixture selection")
      endif()
    endif()
    list(APPEND found "${name}")
  endif()
endforeach()
list(LENGTH found count)
if(NOT count EQUAL 5)
  message(FATAL_ERROR "Expected Lua API and all four lifetime suites: ${found}")
endif()
foreach(required lua-api lua-lifetime-codec lua-lifetime-runtime lua-lifetime-policy lua-lifetime-gc)
  if(NOT required IN_LIST found)
    message(FATAL_ERROR "Missing required Lua suite: ${required}")
  endif()
endforeach()
