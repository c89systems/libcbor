foreach(system 0 1)
  foreach(unverified 0 1)
    foreach(implementation NATIVE REFERENCE)
      foreach(mode encode decode json-control-encode json-control-decode
                   json-to-cbor cbor-to-json reset-control)
        if(implementation STREQUAL "NATIVE")
          if(mode STREQUAL "encode" OR mode STREQUAL "decode")
            set(operation "mapped-${mode}")
          else()
            set(operation "${mode}")
          endif()
          set(arguments 8 0 scalars)
        else()
          if(NOT mode STREQUAL "encode" AND NOT mode STREQUAL "decode")
            continue()
          endif()
          set(operation "${mode}")
          set(arguments 8 scalars)
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env
          "BENCH_SYSTEM_ALLOCATOR=${system}" "BENCH_NO_VERIFY=${unverified}"
          "${${implementation}}" "${operation}" ${arguments}
          RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT status EQUAL 0)
          message(FATAL_ERROR "${implementation} ${operation}: ${error}")
        endif()
        string(STRIP "${output}" output)
        string(REPLACE "\n" ";" rounds "${output}")
        list(LENGTH rounds count)
        if(NOT count EQUAL 5)
          message(FATAL_ERROR "Expected five rounds: ${output}")
        endif()
        foreach(row IN LISTS rounds)
          foreach(key system_allocator untimed_verification records fixture)
            string(JSON ${key} GET "${row}" "${key}")
          endforeach()
          string(JSON allocations GET "${row}" allocation_calls)
          if(NOT system_allocator EQUAL system OR
             NOT untimed_verification EQUAL unverified OR
             NOT records EQUAL 8 OR NOT fixture STREQUAL "scalars" OR
             (system AND NOT allocations EQUAL 0) OR
             (NOT system AND NOT mode STREQUAL "reset-control" AND
              NOT allocations GREATER 0))
            message(FATAL_ERROR "Incorrect audit accounting: ${row}")
          endif()
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
foreach(mode mapped-encode mapped-decode)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env BENCH_TRANSIENT_SCHEMA=1
    "${NATIVE}" "${mode}" 8 0 scalars RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0 OR NOT output MATCHES "\"transient_schema\":1")
    message(FATAL_ERROR "Transient descriptor control failed: ${error}")
  endif()
endforeach()
foreach(implementation NATIVE REFERENCE)
  if(implementation STREQUAL "NATIVE")
    set(operation mapped-decode)
    set(arguments 8 0 missing-fixture)
  else()
    set(operation decode)
    set(arguments 8 missing-fixture)
  endif()
  execute_process(COMMAND "${${implementation}}" "${operation}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_QUIET)
  if(status EQUAL 0 OR NOT output STREQUAL "")
    message(FATAL_ERROR "Unknown fixture must fail without measurements")
  endif()
endforeach()
