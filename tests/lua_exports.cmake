file(READ "${HEADER}" declarations)
string(REGEX MATCHALL "(c89cbor_lua_[a-z_]+|luaopen_cbor)[ \t\r\n]*\\(" functions "${declarations}")
set(expected)
foreach(function IN LISTS functions)
  string(REGEX REPLACE "[ \t\r\n]*\\($" "" function "${function}")
  list(APPEND expected "${function}")
endforeach()
list(REMOVE_DUPLICATES expected)
list(SORT expected)
if(DARWIN)
  execute_process(COMMAND "${NM}" -gU "${MODULE}" OUTPUT_VARIABLE symbols COMMAND_ERROR_IS_FATAL ANY)
else()
  execute_process(COMMAND "${NM}" -D --defined-only "${MODULE}" OUTPUT_VARIABLE symbols COMMAND_ERROR_IS_FATAL ANY)
endif()
string(REPLACE "\n" ";" lines "${symbols}")
set(actual)
foreach(line IN LISTS lines)
  if(line MATCHES "[ \t]_?([A-Za-z_][A-Za-z_0-9]*)$")
    list(APPEND actual "${CMAKE_MATCH_1}")
  endif()
endforeach()
list(SORT actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Lua export mismatch\nExpected: ${expected}\nActual: ${actual}")
endif()
execute_process(COMMAND "${NM}" -u "${MODULE}" OUTPUT_VARIABLE imports COMMAND_ERROR_IS_FATAL ANY)
if(DARWIN)
  execute_process(COMMAND "${INSPECT}" -L "${MODULE}" OUTPUT_VARIABLE dependencies COMMAND_ERROR_IS_FATAL ANY)
else()
  execute_process(COMMAND "${INSPECT}" -d "${MODULE}" OUTPUT_VARIABLE dependencies COMMAND_ERROR_IS_FATAL ANY)
endif()
if(imports MATCHES "cpkt_" OR dependencies MATCHES "libcpkt")
  message(FATAL_ERROR "Lua facade retains a cpkt dependency\n${imports}\n${dependencies}")
endif()
