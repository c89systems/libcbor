@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(lonejson 0.50.0 EXACT CONFIG COMPONENTS jwt)
find_dependency(CpktCore 0.8.0 CONFIG)
list(APPEND CMAKE_FIND_ROOT_PATH "${CpktCore_PREFIX}")
list(APPEND CMAKE_PREFIX_PATH "${CpktCore_PREFIX}")
set(OpenSSL_DIR "${CpktCore_PREFIX}/lib/cmake/OpenSSL")
set(OpenSSL_DIR "${OpenSSL_DIR}" CACHE PATH "OpenSSL from selected cpkt SDK" FORCE)
find_dependency(OpenSSL 3.6.5 CONFIG HINTS "${CpktCore_PREFIX}/lib/cmake/OpenSSL")
include("${CMAKE_CURRENT_LIST_DIR}/C89CborTargets.cmake")
check_required_components(C89Cbor)
