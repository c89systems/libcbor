cmake_minimum_required(VERSION 3.21)
if(NOT ROOT OR NOT EXISTS "${ROOT}/README.md")
  message(FATAL_ERROR "Documentation root must contain README.md: ${ROOT}")
endif()
file(REAL_PATH "${ROOT}" root)
set(queue "${root}/README.md")
set(visited)
while(queue)
  list(POP_FRONT queue document)
  if(document IN_LIST visited)
    continue()
  endif()
  list(APPEND visited "${document}")
  file(READ "${document}" text)
  get_filename_component(directory "${document}" DIRECTORY)
  string(REGEX MATCHALL [=[\]\([^)]+\)]=] links "${text}")
  # Remove the unmatched ']' before treating the matches as a CMake list.
  string(REGEX REPLACE [=[\]\(([^)]+)\)]=] "\\1" targets "${links}")
  foreach(target IN LISTS targets)
    if(target MATCHES "^([A-Za-z][A-Za-z0-9+.-]*:|#)")
      continue()
    endif()
    string(REGEX REPLACE "#.*$" "" target "${target}")
    get_filename_component(resolved "${directory}/${target}" ABSOLUTE)
    if(NOT EXISTS "${resolved}")
      message(FATAL_ERROR "Broken packaged documentation link: ${document} -> ${target}")
    endif()
    file(REAL_PATH "${resolved}" resolved)
    cmake_path(IS_PREFIX root "${resolved}" NORMALIZE within_root)
    if(NOT within_root OR NOT EXISTS "${resolved}")
      message(FATAL_ERROR "Broken packaged documentation link: ${document} -> ${target}")
    endif()
    if(resolved MATCHES "[.]md$")
      list(APPEND queue "${resolved}")
    endif()
  endforeach()
endwhile()
