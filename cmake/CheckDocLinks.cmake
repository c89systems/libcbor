cmake_minimum_required(VERSION 3.21)
if(NOT ROOT OR NOT EXISTS "${ROOT}/README.md")
  message(FATAL_ERROR "Documentation root must contain README.md: ${ROOT}")
endif()
file(REAL_PATH "${ROOT}" root)
function(check_anchor document anchor)
  file(STRINGS "${document}" lines)
  set(anchors)
  set(fenced FALSE)
  foreach(line IN LISTS lines)
    if(line MATCHES "^```")
      if(fenced)
        set(fenced FALSE)
      else()
        set(fenced TRUE)
      endif()
    elseif(NOT fenced AND line MATCHES "^#+ +(.+)$")
      string(TOLOWER "${CMAKE_MATCH_1}" slug)
      string(REGEX REPLACE "[^a-z0-9_ -]" "" slug "${slug}")
      string(REPLACE " " "-" slug "${slug}")
      set(candidate "${slug}")
      set(suffix 0)
      while(candidate IN_LIST anchors)
        math(EXPR suffix "${suffix} + 1")
        set(candidate "${slug}-${suffix}")
      endwhile()
      list(APPEND anchors "${candidate}")
    endif()
  endforeach()
  if(NOT anchor IN_LIST anchors)
    message(FATAL_ERROR "Broken packaged documentation anchor: ${document}#${anchor}")
  endif()
endfunction()
set(queue "${root}/README.md")
set(visited)
while(queue)
  list(POP_FRONT queue document)
  if(document IN_LIST visited)
    continue()
  endif()
  list(APPEND visited "${document}")
  file(READ "${document}" text)
  get_filename_component(directory "${document}" DIRECTORY)
  string(REGEX MATCHALL [=[\]\([^)]+\)]=] links "${text}")
  # Remove the unmatched ']' before treating the matches as a CMake list.
  string(REGEX REPLACE [=[\]\(([^)]+)\)]=] "\\1" targets "${links}")
  foreach(target IN LISTS targets)
    if(target MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:")
      continue()
    endif()
    set(anchor "")
    if(target MATCHES "#(.+)$")
      set(anchor "${CMAKE_MATCH_1}")
    endif()
    string(REGEX REPLACE "#.*$" "" target "${target}")
    if(target STREQUAL "")
      set(resolved "${document}")
    else()
      get_filename_component(resolved "${directory}/${target}" ABSOLUTE)
    endif()
    if(NOT EXISTS "${resolved}")
      message(FATAL_ERROR "Broken packaged documentation link: ${document} -> ${target}")
    endif()
    file(REAL_PATH "${resolved}" resolved)
    cmake_path(IS_PREFIX root "${resolved}" NORMALIZE within_root)
    if(NOT within_root OR NOT EXISTS "${resolved}")
      message(FATAL_ERROR "Broken packaged documentation link: ${document} -> ${target}")
    endif()
    if(resolved MATCHES "[.]md$")
      if(anchor)
        check_anchor("${resolved}" "${anchor}")
      endif()
      list(APPEND queue "${resolved}")
    endif()
  endforeach()
endwhile()
