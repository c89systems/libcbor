set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES C89CBOR_TARGET C89CBOR_AFL CPKT_LIFECYCLE_SCRIPTS_DIR)
if(NOT CPKT_LIFECYCLE_SCRIPTS_DIR)
  message(FATAL_ERROR "Set CPKT_LIFECYCLE_SCRIPTS_DIR to the activated lifecycle scripts directory")
endif()
execute_process(COMMAND "${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-toolchains.sh" discover "${C89CBOR_TARGET}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE description ERROR_VARIABLE error)
if(NOT rc EQUAL 0 OR NOT description MATCHES "(^|[\r\n])status=ready([\r\n]|$)")
  message(FATAL_ERROR "Pinned toolchain unavailable: ${description}${error}")
endif()
foreach(key cc cxx ld ar ranlib strip nm objcopy objdump readelf sysroot root prefix otool)
  string(REGEX MATCH "(^|[\r\n])${key}=([^\r\n]+)" match "${description}")
  if(match)
    set(tool_${key} "${CMAKE_MATCH_2}")
  endif()
endforeach()
set(CMAKE_C_COMPILER "${tool_cc}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${tool_cxx}" CACHE FILEPATH "" FORCE)
if(C89CBOR_AFL)
  execute_process(COMMAND "${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-aflpp.sh" discover
    RESULT_VARIABLE afl_rc OUTPUT_VARIABLE afl_description)
  if(NOT afl_rc EQUAL 0)
    message(FATAL_ERROR "Pinned AFL++ is not prepared")
  endif()
  string(REGEX MATCH "(^|[\r\n])cc=([^\r\n]+)" match "${afl_description}")
  set(CMAKE_C_COMPILER "${CMAKE_MATCH_2}" CACHE FILEPATH "" FORCE)
endif()
set(CMAKE_AR "${tool_ar}" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${tool_ranlib}" CACHE FILEPATH "" FORCE)
set(CMAKE_STRIP "${tool_strip}" CACHE FILEPATH "" FORCE)
set(CMAKE_NM "${tool_nm}" CACHE FILEPATH "" FORCE)
set(CMAKE_LINKER "${tool_ld}" CACHE FILEPATH "" FORCE)
if(C89CBOR_TARGET MATCHES "apple")
  set(CMAKE_SYSTEM_NAME Darwin)
  set(CMAKE_SYSTEM_PROCESSOR arm64)
  set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0" CACHE STRING "macOS baseline matching cpkt" FORCE)
  set(CMAKE_EXE_LINKER_FLAGS_INIT "--ld-path=${tool_ld}")
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "--ld-path=${tool_ld}")
  set(CMAKE_MODULE_LINKER_FLAGS_INIT "--ld-path=${tool_ld}")
  set(CMAKE_OTOOL "${tool_otool}" CACHE FILEPATH "" FORCE)
else()
  set(CMAKE_SYSTEM_NAME Linux)
  string(REGEX REPLACE "-linux-.*" "" CMAKE_SYSTEM_PROCESSOR "${C89CBOR_TARGET}")
  set(CMAKE_SYSROOT "${tool_sysroot}" CACHE PATH "" FORCE)
  set(CMAKE_FIND_ROOT_PATH "${tool_sysroot}" "${tool_root}")
  set(CMAKE_READELF "${tool_readelf}" CACHE FILEPATH "" FORCE)
  set(CMAKE_OBJDUMP "${tool_objdump}" CACHE FILEPATH "" FORCE)
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
