# Compile/run the shipped examples directly, so documentation cannot drift from tests.
function(c89_readme_example readme language output)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${readme}")
  file(READ "${readme}" text)
  string(REGEX MATCHALL "```${language}\n" examples "${text}")
  list(LENGTH examples count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one complete ${language} example in ${readme}")
  endif()
  string(REGEX MATCH "```${language}\n([^`]+)```" example "${text}")
  if(NOT example)
    message(FATAL_ERROR "Unterminated ${language} example in ${readme}")
  endif()
  file(WRITE "${output}" "${CMAKE_MATCH_1}")
endfunction()
