prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
Name: c89cbor
Description: Bounded streaming RFC 8949 CBOR for C89
Version: @PROJECT_VERSION@
Requires: lonejson = 0.49.0
Libs: -L${libdir} -lcbor
Libs.private: -lm
Cflags: -I${includedir}
