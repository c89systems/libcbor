# Generate receiver-parity assertions and the public API reference from the
# declarations. New exports must resolve to a receiver or an explicit exception.
set(api_headers)
set(api_declarations "")
foreach(name cbor io cose cwt lonejson lua)
  set(header "${CMAKE_CURRENT_SOURCE_DIR}/include/c89cbor/${name}.h")
  list(APPEND api_headers "${header}")
  file(READ "${header}" text)
  string(APPEND api_declarations "${text}\n")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${api_headers})
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/lua/cbor.c" lua_source)
string(REGEX MATCHALL "C89CBOR_API[ \t\r\n]+[^;]+;" api_prototypes "${api_declarations}")
string(REGEX MATCHALL "(c89cbor_[a-z_0-9]+|luaopen_cbor)[ \t\r\n]*\\(" api_functions "${api_prototypes}")
list(TRANSFORM api_functions REPLACE "[ \t\r\n]*\\($" "")
list(REMOVE_DUPLICATES api_functions)
list(SORT api_functions)
set(C89_API_ASSERTIONS "")
set(api_reference "# Public API inventory\n\nGenerated from the public headers by CMake. Receiver twins share their\nimplementation. The API surface tests compare their function pointers in\ninstalled static/shared consumers; Lua exports and native interop are checked\nseparately. Lua cleanup/destroy are aliases for close with Lua ownership rules.\nMap methods accept a typed native record view. Binding methods are native C\nembedding interfaces and do not move records through Lua tables.\n\n| Export | C receiver or exception | Lua surface |\n| --- | --- | --- |\n")
foreach(function IN LISTS api_functions)
  set(assertion "")
  set(member "")
  if(function STREQUAL "luaopen_cbor")
    set(receiver "Module opener bootstrap")
    set(lua "require('cbor')")
  elseif(function MATCHES "^c89cbor_lua_(init|create)$")
    set(receiver "Binding bootstrap")
    set(lua "Native embedder")
  elseif(function MATCHES "^c89cbor_(init|create)$")
    set(receiver "Runtime bootstrap")
    set(lua "cbor.${CMAKE_MATCH_1}")
  elseif(function MATCHES "^c89cbor_default_(allocator|config|options|cose_options|cwt_options)$")
    set(receiver "Value helper; runtime.default_${CMAKE_MATCH_1} twin")
    set(lua "cbor.default_${CMAKE_MATCH_1}")
  elseif(function MATCHES "^c89cbor_lua_(.+)$")
    set(member "${CMAKE_MATCH_1}")
    set(receiver "binding.${member}")
    set(lua "Native binding.${member}")
    if(NOT lua_source MATCHES "binding->${member}[ \t\r\n]*=[ \t\r\n]*${function}")
      message(FATAL_ERROR "Missing binding receiver assignment for ${function}")
    endif()
  elseif(function MATCHES "^c89cbor_(encoder|decoder|reader|transfer|fd|cose_key|cwt)_(init|create)$")
    set(member "${CMAKE_MATCH_1}_${CMAKE_MATCH_2}")
    set(receiver "runtime.${member}")
    set(lua "runtime:${member}")
    set(assertion "runtime.${member}")
  elseif(function MATCHES "^c89cbor_(encoder|decoder|reader|transfer|fd|conversion|cose_key|cose_operation|cwt)_(.+)$")
    set(member "${CMAKE_MATCH_2}")
    set(receiver "${CMAKE_MATCH_1}.${member}")
    set(lua "${CMAKE_MATCH_1}:${member}")
    set(assertion "${CMAKE_MATCH_1}.${member}")
  else()
    string(REGEX REPLACE "^c89cbor_(runtime_)?" "" member "${function}")
    set(receiver "runtime.${member}")
    set(lua "runtime:${member}")
    set(assertion "runtime.${member}")
  endif()
  if(NOT member STREQUAL "")
    if(NOT api_declarations MATCHES "\\(\\*${member}\\)")
      message(FATAL_ERROR "No receiver member for ${function}: ${member}")
    endif()
    if(NOT function MATCHES "^c89cbor_lua_" AND NOT lua_source MATCHES "\"${member}\"")
      message(FATAL_ERROR "No Lua registration for ${function}: ${member}")
    endif()
  endif()
  if(NOT assertion STREQUAL "")
    string(APPEND C89_API_ASSERTIONS "  assert(${assertion} == ${function});\n")
  endif()
  string(APPEND api_reference "| `${function}` | ${receiver} | ${lua} |\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/api-inventory.md" "${api_reference}")
configure_file(tests/api_surface.c.in api_surface.c @ONLY)
foreach(kind static shared)
  add_executable(api_${kind}_test "${CMAKE_CURRENT_BINARY_DIR}/api_surface.c" tests/stack.c)
  c89_owned(api_${kind}_test)
  target_compile_options(api_${kind}_test PRIVATE -UNDEBUG)
  target_link_libraries(api_${kind}_test PRIVATE c89cbor_${kind} Threads::Threads)
  c89_runtime(api_${kind}_test)
  add_test(NAME api-${kind} COMMAND api_${kind}_test)
endforeach()
add_test(NAME api-inventory COMMAND ${CMAKE_COMMAND} -E compare_files
  "${CMAKE_CURRENT_BINARY_DIR}/api-inventory.md" "${CMAKE_CURRENT_SOURCE_DIR}/docs/api-inventory.md")
